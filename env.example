# Required: a single Google API key for Gemini image + vision models.
# Get one at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your-google-api-key-here

# The image-editing model that performs the restoration. Swap this one value to point
# the pipeline at a different Google image model.
RESTORE_IMAGE_MODEL=gemini-2.5-flash-image

# Vision model used for damage/era analysis and post-restoration verification.
ANALYSIS_MODEL=gemini-2.5-flash

# How many times the restore step may be retried when verification fails (1-10).
MAX_RESTORE_ATTEMPTS=2

# Base directory for output (one timestamped subdir is created per restored photo).
OUTPUT_DIR=restored_photos
